#: lmn_setup_wizard/partial/init-school.html:52
#: lmn_setup_wizard/partial/init-welcome.html:648
msgid "Next"
msgstr "Suivant"

#: lmn_setup_wizard/partial/init-account.html:8
msgid ""
"Note: Minimal length is 7 characters. Use upper, lower and special "
"characters or numbers. (e.g. mUster!)"
msgstr ""
"Note: Minimum 7 caractères. Utiliser des majuscules, minuscules, caractères "
"spéciaux et chiffres (par exemple Muster!)"

#: lmn_setup_wizard/partial/init-school.html:41
msgid ""
"Note: The first part (up to the first dot) of the domain name will be used "
"as the SAMBA domain and has a maximal length of 15 characters. We suggest to "
"use &quot;linuxmuster&quot; or &quot;lmn&quot; and prepend it to your domain."
msgstr ""
"Note : La première partie du nom de domaine ( avant le point ) sera utilisé "
"en tant que domaine SAMBA, et doit avoir une longueur maximale de 15 "
"caractères. On suggère de préfixer le domaine par &quot;linuxmuster&quot; ou "
"&quot;lmn&quot;."

#: lmn_setup_wizard/partial/init-account.html:23
